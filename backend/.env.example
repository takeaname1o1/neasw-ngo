MAIL_USERNAME=neaswsubmission@zohomail.in
MAIL_PASSWORD=YOUR_ZOHO_APP_PASSWORD
MAIL_FROM=notifications@neaswwelfarefoundation.in
MAIL_FROM_NAME=NorthEast Association for Social Welfare
MAIL_SERVER=smtp.zoho.in
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True
MAIL_TO_ADMIN=neaswsubmission@zohomail.in
## DATABASE_URL is supplied by Neon in the root .env.local during development.
## On Render, set both values under the backend service's Environment tab.
## Never place database credentials in frontend/VITE_ environment variables.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Without DATABASE_URL, local development uses backend/neasw.db.

# Enable after adding your Brevo API key privately on Render.
# HTTPS works on Render Free; SMTP ports 25/465/587 are blocked.
MAIL_ENABLED=False
MAIL_PROVIDER=brevo
BREVO_API_KEY=
# For legacy SMTP on a compatible host: MAIL_PROVIDER=smtp

# Private admin dashboard: set these on the backend only.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECONDS=28800
ADMIN_COOKIE_SECURE=True
# Local HTTP testing only: ADMIN_COOKIE_SECURE=False
# Existing root .env.local USER/PASSWORD entries are also supported locally.

# Optional private Excel export limits; defaults suit one Render Free worker.
EXPORT_MAX_ROWS=25000
EXPORT_MAX_FILE_MB=25
EXPORT_MAX_CONCURRENT=1
# MAX_FILE_MB also caps total source characters at this value * 1,048,576.
